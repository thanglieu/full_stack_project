generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}













// =====================
// USER
// =====================
model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  name      String
  gender    String    // 'Nam' | 'Nữ'
  birth     DateTime?
  email     String    @unique
  mark      Int       @default(0)
  isAdmin   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  series   Series[]
  articles Article[]
  comments Comment[]
  likes    Like[]
  tests     Test[]
  userTests UserTest[]
  practices     Practice[]
  userPractices UserPractice[]

  @@map("users")
}

// =====================
// TOPIC
// =====================
model Topic {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  articles Article[] @relation("ArticleTopics")
  tests Test[] @relation("TestTopics")
  practices Practice[] @relation("PracticeTopics")
  @@map("topics")
}

// =====================
// SERIES
// =====================
model Series {
  id       Int    @id @default(autoincrement())
  name     String
  authorId Int
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  articleLists ArticleList[]

  @@map("series")
}

// =====================
// ARTICLE
// =====================
model Article {
  id        Int      @id @default(autoincrement())
  title     String
  like      Int      @default(0)
  content   String
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  topics       Topic[]       @relation("ArticleTopics")
  articleLists ArticleList[]
  comments     Comment[]
  likes        Like[]

  @@map("articles")
}

// =====================
// ARTICLE_LIST
// =====================
model ArticleList {
  id        Int @id @default(autoincrement())
  seriesId  Int
  articleId Int

  series  Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_lists")
}

// =====================
// COMMENT
// =====================
model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  authorId  Int?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  articleId Int
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("comments")
}

// =====================
// LIKE
// =====================
model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  articleId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("likes")
}
















// =====================
// EXAM
// =====================
model Test {
  id        Int      @id @default(autoincrement())
  title     String
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  createdAt DateTime @default(now())

  topics     Topic[]     @relation("TestTopics")
  questions  Question[]
  userTests  UserTest[]

  @@map("tests")
}

model Question {
  id     Int    @id @default(autoincrement())
  testId Int
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
  text   String
  stt    Int    @default(0)

  answers Answer[]

  @@map("questions")
}

model Answer {
  id         Int     @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  title      String  @default("a")
  text       String
  isCorrect  Boolean @default(false)

  userAnswers UserAnswer[]

  @@map("answers")
}

model UserTest {
  id     Int    @id @default(autoincrement())
  userId Int
  testId Int
  score  Float?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  test        Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  userAnswers UserAnswer[]

  @@unique([userId, testId])
  @@map("user_tests")
}

model UserAnswer {
  id         Int @id @default(autoincrement())
  userTestId Int
  answerId   Int

  userTest UserTest @relation(fields: [userTestId], references: [id], onDelete: Cascade)
  answer   Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userTestId, answerId])
  @@map("user_answers")
}












// ===== PRACTICE =====
model Practice {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  code      String   // code mẫu / code chuẩn
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  topics         Topic[]         @relation("PracticeTopics")
  testCases      TestCase[]
  userPractices  UserPractice[]

  @@map("practices")
}

model TestCase {
  id         Int      @id @default(autoincrement())
  stt        Int
  practiceId Int
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  input      String
  output     String

  @@map("test_cases")
}

model UserPractice {
  id         Int      @id @default(autoincrement())
  userId     Int
  practiceId Int
  mark       Int      @default(0)
  userCode   String
  language   String   @default("")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@unique([userId, practiceId])
  @@map("user_practices")
}



