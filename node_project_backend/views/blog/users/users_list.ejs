<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bảng xếp hạng - PTITShare</title>
  <style>
    :root {
        --green: #04AA6D;
        --dark: #282A35;
        --gray-bg: #f6f6f6;
        --border: #e0e0e0;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: var(--gray-bg);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ══ NAVBAR CHUẨN ══ */
    .navbar {
        background: var(--green); color: white; padding: 0 32px; height: 52px;
        display: flex; align-items: center; box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    .nav-logo { font-size: 19px; font-weight: 700; color: #fff; text-decoration: none; margin-right: 20px; }
    .nav-logo span { color: var(--dark); }
    .nav-dropdown { position: relative; cursor: pointer; }
    .nav-dropdown-btn { color: #fff; font-size: 13.5px; font-weight: 700; padding: 0 14px; height: 52px; display: flex; align-items: center; }
    .nav-dropdown:hover .nav-dropdown-btn { background: rgba(0,0,0,.15); }
    .nav-dropdown-menu {
        display: none; position: absolute; top: 100%; left: 0; background: var(--dark);
        border-radius: 0 0 6px 6px; min-width: 140px; box-shadow: 0 6px 20px rgba(0,0,0,.3); z-index: 200;
    }
    .nav-dropdown:hover .nav-dropdown-menu { display: block; }
    .nav-dropdown-menu a { display: block; color: #ccc; text-decoration: none; font-size: 13.5px; padding: 10px 18px; }
    .nav-dropdown-menu a:hover { background: var(--green); color: #fff; }
    .nav-spacer { flex: 1; }
    .nav-link { color: #fff; text-decoration: none; font-size: 13.5px; font-weight: 700; padding: 0 14px; height: 52px; display: flex; align-items: center; }
    .nav-link:hover { background: rgba(0,0,0,.15); }

    /* ══ NỘI DUNG ══ */
    .container { max-width: 1000px; margin: 40px auto; padding: 0 20px; flex: 1; width: 100%; }
    h1 { text-align: center; color: var(--dark); margin-bottom: 30px; }

    .table-container { background: white; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); overflow: hidden; }
    table { width: 100%; border-collapse: collapse; }
    thead { background: #f8f9fa; }
    th { padding: 16px 20px; text-align: left; font-size: 13px; color: #666; text-transform: uppercase; border-bottom: 2px solid var(--gray-bg); }
    td { padding: 16px 20px; border-bottom: 1px solid var(--gray-bg); }
    
    .rank-column { font-weight: 700; color: var(--green); }
    td a { color: var(--dark); text-decoration: none; font-weight: 600; }
    td a:hover { color: var(--green); }
    .mark-cell { font-weight: 700; color: #ff9800; }

    /* ══ FOOTER CHUẨN ══ */
    footer { background: var(--dark); padding: 20px; text-align: center; color: #bbb; font-size: 14px; font-weight: 600; margin-top: 40px; }
    footer a { color: var(--green); text-decoration: none; }
  </style>
</head>
<body>
  <nav class="navbar">
      <a class="nav-logo" href="/blog">PTIT<span>Share</span></a>
      <div class="nav-dropdown">
          <div class="nav-dropdown-btn">Khám phá ▾</div>
          <div class="nav-dropdown-menu">
              <a href="/blog">Blog</a>
              <a href="/exam">Exam</a>
              <a href="/practice">Practice</a>
          </div>
      </div>
      <div class="nav-spacer"></div>
      <a href="/blog/users/this-user" class="nav-link">Trang cá nhân</a>
      <a href="/blog/users/rank" class="nav-link" style="background: rgba(0,0,0,.15);">Xếp hạng</a>
      <a href="/blog/logout" class="nav-link">Đăng xuất</a>
  </nav>

  <div class="container">
    <h1>🏆 Bảng xếp hạng</h1>
    <% if (users && users.length) { %>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Người dùng</th>
              <th>Email</th>
              <th>Giới tính</th>
              <th>Điểm</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(user, index) { %>
              <tr>
                <td class="rank-column"><%= index + 1 %></td>
                <td><a href="/blog/users/<%= user.id %>"><%= user.name %></a></td>
                <td><%= user.email %></td>
                <td><%= user.gender || '—' %></td>
                <td class="mark-cell"><%= user.mark %> ⭐</td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 50px;">📭 Chưa có người dùng nào.</div>
    <% } %>
  </div>

  <footer>&copy; 2026 PTITShare &mdash; Powered by <a href="#">Express</a></footer>
</body>
</html>