<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Làm Practice – PTITShare</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;600&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --green:       #04AA6D;
            --green-dark:  #059862;
            --green-light: #e8f8f2;
            --dark:        #282A35;
            --gray-bg:     #fafafa;
            --border:      #e5e5e5;
            --muted:       #6c757d;
            
            /* Định dạng màu tối cho editor */
            --code-bg:       #1e1e1e; 
            --code-text:     #f4f4f4;
            --code-border:   #333333;
        }

        h1 {
            color: #1f3a5d;
            font-size: 26px;
            font-weight: 800;
            margin-bottom: 24px;
        }
        
        /* Reset cứng để không bị cuộn toàn trang */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden; 
            font-family: 'Nunito', sans-serif;
            background: var(--gray-bg);
            color: var(--dark);
        }

        body {
            display: flex;
            flex-direction: column;
        }

        /* ══ NAVBAR ══ */
        .navbar {
            background: var(--green);
            height: 52px;
            display: flex;
            align-items: center;
            padding: 0 24px;
            border-bottom: 1px solid var(--green-dark);
            box-shadow: 0 2px 8px rgba(0,0,0,.15);
            z-index: 100;
        }
        .nav-logo {
            font-family: 'Source Code Pro', monospace;
            font-size: 19px;
            font-weight: 700;
            color: #fff;
            text-decoration: none;
            margin-right: 20px;
        }
        .nav-logo span { color: var(--dark); }
        .nav-dropdown { position: relative; }
        .nav-dropdown-btn {
            display: flex;
            align-items: center;
            gap: 5px;
            color: #fff;
            font-size: 13.5px;
            font-weight: 700;
            padding: 0 14px;
            height: 52px;
            cursor: pointer;
            user-select: none;
            transition: background .15s;
        }
        .nav-dropdown-btn:hover,
        .nav-dropdown:hover .nav-dropdown-btn { background: rgba(0,0,0,.12); }
        
        .nav-dropdown-menu {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: var(--dark);
            border-radius: 0 0 6px 6px;
            min-width: 140px;
            box-shadow: 0 6px 20px rgba(0,0,0,.3);
            z-index: 200;
        }
        .nav-dropdown:hover .nav-dropdown-menu { display: block; }
        .nav-dropdown-menu a {
            display: block;
            color: #ccc;
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 600;
            padding: 10px 18px;
        }
        .nav-dropdown-menu a:hover { background: var(--green); color: #fff; }
        
        .nav-spacer { flex: 1; }
        .nav-divider {
            width: 1px;
            height: 22px;
            background: rgba(255,255,255,.3);
            margin: 0 8px;
        }
        .nav-link {
            color: #fff;
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 700;
            padding: 0 14px;
            height: 52px;
            display: flex;
            align-items: center;
            white-space: nowrap;
        }
        .nav-link:hover { background: rgba(0,0,0,.12); color: #fff; }

        /* ══ MAIN LAYOUT ══ */
        .page-wrapper {
            flex: 1;
            display: flex;
            padding: 12px; 
            gap: 12px;
            height: calc(100vh - 87px);
            box-sizing: border-box;
        }

        .left-panel {
            flex: 5;
            background: #fff;
            border-radius: 8px;
            border: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .right-panel {
            flex: 7;
            display: flex;
            flex-direction: column;
            gap: 12px;
            overflow: hidden;
        }

        /* ══ ĐỊNH DẠNG TABS CỦA LEETCODE ══ */
        .panel-tabs {
            background: #fdfdfd;
            border-bottom: 1px solid var(--border);
            padding: 0 12px;
            height: 40px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .panel-tab-item {
            font-size: 13.5px;
            font-weight: 600;
            color: var(--muted);
            padding: 8px 12px;
            cursor: pointer;
            border-bottom: 2px solid transparent;
            user-select: none;
            transition: color .15s;
        }
        .panel-tab-item:hover {
            color: var(--dark);
        }
        /* Tab đang được chọn kích hoạt */
        .panel-tab-item.active {
            font-weight: 700;
            color: var(--dark);
            border-bottom: 2px solid var(--dark);
        }

        .panel-content {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
        }

        /* Ẩn/Hiện nội dung các tab */
        .tab-content-item {
            display: none;
        }
        .tab-content-item.active {
            display: block;
        }

        .page-header {
            border-bottom: 1px solid #000;    /* đường gạch mảnh màu đen */
            padding-bottom: 8px;                /* tạo khoảng cách giữa nội dung và gạch */
            margin-bottom: 12px;                /* khoảng cách với phần sau */
        }

        .page-header h1 { 
            font-size: 22px; 
            font-weight: 700; 
            margin-bottom: 6px;
        }
        
        /* ══ FORM & CODE EDITOR ══ */
        .editor-container {
            flex: 1;
            background: #fff;
            border-radius: 8px;
            border: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        textarea {
            width: 100%;
            height: 100%;
            flex: 1;
            border: none;
            padding: 16px;
            font-family: 'Source Code Pro', monospace;
            font-size: 14px;
            resize: none;
            outline: none;
            line-height: 1.5;
            background-color: var(--code-bg);
            color: var(--code-text);
            caret-color: var(--green);
        }
        
        pre {
            background-color: var(--code-bg);
            color: #a9b7c6;
            padding: 6px 10px;
            border-radius: 4px;
            border: 1px solid var(--code-border);
            font-family: 'Source Code Pro', monospace;
            font-size: 13px;
        }

        /* ══ BOTTOM CONSOLE ══ */
        .bottom-console {
            background: #fff;
            border-radius: 8px;
            border: 1px solid var(--border);
            padding: 12px 20px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
        }

        .btn-run {
            width: 100px;
            background: var(--green);
            color: #fff;
            font-weight: 700;
            font-size: 14px;
            padding: 8px 24px;
            border-radius: 6px;
            border: none;
            transition: background .15s;
        }
        .btn-run:hover { background: var(--green-dark); }

        .ptit-table thead tr { background: #f5f5f5; color: #555; }
        .badge-success { color: var(--green-dark); font-weight: 700; }
        .badge-danger { color: #c0392b; font-weight: 700; }
        
        footer {
            background: #fff;
            color: #888;
            text-align: center;
            padding: 8px;
            font-size: 12px;
            border-top: 1px solid var(--border);
        }
        footer a { color: var(--green); text-decoration: none; }
    </style>
</head>
<body>
<nav class="navbar">
    <a class="nav-logo" href="/blog">PTIT<span>Share</span></a>
    <div class="nav-dropdown">
        <div class="nav-dropdown-btn">Khám phá ▾</div>
        <div class="nav-dropdown-menu">
            <a href="/blog">Blog</a>
            <a href="/exam">Exam</a>
            <a href="/practice">Practice</a>
        </div>
    </div>
    <div class="nav-spacer"></div>
    <div class="nav-divider"></div>
    <a href="/blog/users/this-user" class="nav-link">Trang cá nhân</a>
    <a href="/blog/users/rank" class="nav-link">Xếp hạng</a>
    <a href="/blog/logout" class="nav-link">Đăng xuất</a>
</nav>

<div class="page-wrapper">
    <div class="left-panel">
        <div class="panel-tabs">
            <% if (m) { %>
                <div class="panel-tab-item" data-target="tab-testcase">Testcase</div>
            <% } else { %>
                <div class="panel-tab-item active" data-target="tab-description">Description</div>
                <div class="panel-tab-item" data-target="tab-testcase">Testcase</div>
                <div class="panel-tab-item" data-target="tab-answer">Answer</div>
            <% } %>
        </div>

        <div class="panel-content">
            <div id="tab-description" class="tab-content-item <%= m ? '' : 'active' %>">
                <h1 style="margin: 0 0 15px 0; font-size: 24px; font-weight: 700;"><%= practice.title %></h1>
                <div style="font-size: 14px; margin-bottom: 10px; border-bottom: 1px solid #eaecef; padding-bottom: 10px;">
                    <strong>Tác giả:</strong>
                    <a href="/blog/users/<%= practice.author.id %>"><%= practice.author.username %></a>
                </div>
                <div style="font-size: 15px; line-height: 1.6;">
                    <strong>Mô tả:</strong>
                    <div style="white-space: pre-line;"><%= practice.content %></div>
                </div>
            </div>

            <div id="tab-testcase" class="tab-content-item">
                <% if (user_code) { %>
                    <% if (k == 0) { %>
                        <p style="color: red;">Lần làm bài trước</p>
                    <% } %>
                    <p class="fw-bold mb-3">Điểm: <%= mark %> / <%= (user_outputs && user_outputs.length) || 5 %></p>
                    <table class="ptit-table table table-sm table-bordered align-middle" style="font-size: 13.5px;">
                        <thead>
                            <tr>
                                <th>Input</th>
                                <th>Output chuẩn</th>
                                <th>Output của bạn</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% (user_outputs || []).forEach(function(u) { %>
                                <tr>
                                    <td><%= u.input %></td>
                                    <td><%= u.expected %></td>
                                    <td><%= u.user_output %></td>
                                    <td class="text-center">
                                        <% if (u.is_correct) { %>
                                            <span class="badge-success">✔ Pass</span>
                                        <% } else { %>
                                            <span class="badge-danger">✘ Fail</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <div class="text-center text-muted py-5"><p>Chưa có code.</p></div>
                <% } %>
            </div>

            <div id="tab-answer" class="tab-content-item">
                <div class="text-center text-muted py-5"><p>Lời giải chính thức.</p></div>
            </div>
        </div>
    </div>

    <div class="right-panel">
        <form method="post" action="/practice/<%= practice.id %>/take" class="h-100 d-flex flex-column gap-2" style="flex: 1;">
            <div class="editor-container">
                <div class="panel-tabs d-flex justify-content-between align-items-center">
                    <strong>Code</strong>
                    <% if (!m) { %>
                        <select name="language_type">
                            <option value="python" <%= language === 'python' ? 'selected' : '' %>>Python</option>
                            <option value="java" <%= language === 'java' ? 'selected' : '' %>>Java</option>
                            <option value="c++" <%= language === 'c++' ? 'selected' : '' %>>C++</option>
                        </select>
                    <% } else { %>
                        <span><%= language %></span>
                    <% } %>
                </div>
                <textarea name="user_code" <%= m ? 'readonly' : '' %>><%= user_code || '' %></textarea>
            </div>
            <% if (!m) { %>
                <button type="submit" class="btn-run align-self-end">Submit</button>
            <% } %>
        </form>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const tabItems = document.querySelectorAll(".left-panel .panel-tab-item");
    const contentItems = document.querySelectorAll(".left-panel .tab-content-item");

    function switchTab(targetId) {
        tabItems.forEach(item => item.classList.remove("active"));
        contentItems.forEach(content => content.classList.remove("active"));
        const activeTabBtn = document.querySelector('[data-target="' + targetId + '"]');
        if (activeTabBtn) activeTabBtn.classList.add("active");
        const activeContent = document.getElementById(targetId);
        if (activeContent) activeContent.classList.add("active");
    }

    tabItems.forEach(item => {
        item.addEventListener("click", function () {
            switchTab(this.getAttribute("data-target"));
        });
    });

    <% if (m || k == 1) { %>
        switchTab("tab-testcase");
    <% } %>
});
</script>
</body>
</html>